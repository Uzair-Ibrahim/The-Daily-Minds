SEARCH_PROVIDER=exa
# Enable only after confirming existing no-payment free credits. RSS needs no key.
CREDIT_SEARCH_CONFIRMED_FREE=false
EXA_API_KEY=
TAVILY_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=none
LLM_MODEL=
LIVE_REQUEST_TIMEOUT_SECONDS=20
# In-memory evidence cache; use_cache=true opts in. Set 0 to disable.
LIVE_CACHE_TTL_SECONDS=180
LOG_LEVEL=INFO
DATABASE_PATH=data/daily_mind.sqlite3
# Local startup catch-up + daily date checks; background retrieval is RSS only.
DAILY_GENERATION_ENABLED=true
DAILY_GENERATION_INTERVAL_SECONDS=60
DAILY_GENERATION_RETRY_SECONDS=300
OFFLINE_NEWS_MAX_AGE_DAYS=7
# Optional free local CPU story embeddings. Runtime never downloads model weights.
# Install: python -m pip install -e ".[stories]"
# Download once: python scripts/setup_story_model.py
STORY_SEMANTIC_ENABLED=true
STORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STORY_SIMILARITY_THRESHOLD=0.68
# STORY_MODEL_CACHE defaults to ~/.cache/daily-mind-models, outside Git.

# Optional Supabase Free-plan Auth. Never use a service_role or secret key.
SUPABASE_AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local SQLite remains default. Cloud deployment requires Postgres explicitly.
DATABASE_BACKEND=sqlite
DATABASE_URL=
DATABASE_SCHEMA=daily_mind
