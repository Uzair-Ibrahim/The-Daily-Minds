SEARCH_PROVIDER=exa
# Enable only after confirming existing no-payment free credits. RSS needs no key.
CREDIT_SEARCH_CONFIRMED_FREE=false
EXA_API_KEY=
TAVILY_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=none
LLM_MODEL=
LIVE_REQUEST_TIMEOUT_SECONDS=20
# In-memory evidence cache; use_cache=true opts in. Set 0 to disable.
LIVE_CACHE_TTL_SECONDS=180
LOG_LEVEL=INFO
DATABASE_PATH=data/daily_mind.sqlite3
# Local startup catch-up + daily date checks; background retrieval is RSS only.
DAILY_GENERATION_ENABLED=true
DAILY_GENERATION_INTERVAL_SECONDS=60
DAILY_GENERATION_RETRY_SECONDS=300
OFFLINE_NEWS_MAX_AGE_DAYS=7
